{
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "preview:worker": "npm run build && wrangler dev",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "typecheck": "astro check",
    "test": "npm run test:music && npm run test:palettes",
    "test:browser": "playwright test",
    "verify": "npm run check && npm test && npm run build",
    "test:music": "node --experimental-strip-types --test tests/music*.test.mjs",
    "test:palettes": "node --experimental-strip-types --test tests/palettes.test.mjs",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write . && prettier --write '**/*.{astro,md,mdx,yml,yaml}'",
    "format:check": "biome format . && prettier --check '**/*.{astro,md,mdx,yml,yaml}'",
    "deploy": "npm run build && wrangler deploy",
    "deploy:preview": "npm run build && wrangler versions upload",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.8",
    "@astrojs/react": "^6.0.4",
    "@teamdandelion/polysome": "1.1.0",
    "astro": "^7.2.6",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@biomejs/biome": "2.2.2",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "^4.1.12",
    "@types/node": "24.13.6",
    "@types/react": "^19.1.11",
    "@types/react-dom": "^19.1.7",
    "daisyui": "^5.0.50",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.6",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.0.1",
    "tailwindcss": "^4.1.12",
    "typescript": "^5.9.2",
    "wrangler": "^4.125.0"
  },
  "type": "module"
}
