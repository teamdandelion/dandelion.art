---
import PaletteTuner from "./PaletteTuner.astro";
---
<button class="design-launcher" type="button" aria-label="Design settings" title="Design settings" aria-controls="design-tray" aria-expanded="false" aria-haspopup="dialog">
  <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M12 3a9 9 0 1 0 0 18h1a2 2 0 0 0 1.5-3.3 1.5 1.5 0 0 1 1.1-2.5H18a3 3 0 0 0 3-3C21 7 17 3 12 3Z" />
    <circle cx="7" cy="11" r=".8" /><circle cx="10" cy="7" r=".8" /><circle cx="15" cy="7" r=".8" /><circle cx="18" cy="11" r=".8" />
  </svg>
</button>
<dialog id="design-tray" class="design-tray" aria-labelledby="design-title">
  <header><h2 id="design-title">Design</h2><a href="/design/palettes/">Full lab ↗</a><button type="button" data-close-design aria-label="Close design settings">×</button></header>
  <p class="design-scope">Colors apply site-wide. Copied links show this page.</p>
  <PaletteTuner compact />
</dialog>
<script>
  import { applyColors } from "../lib/palette-custom";
  applyColors();
  const launcher = document.querySelector<HTMLButtonElement>(".design-launcher")!;
  const tray = document.querySelector<HTMLDialogElement>(".design-tray")!;
  function close() { tray.close(); launcher.setAttribute("aria-expanded", "false"); launcher.focus({preventScroll:true}); }
  launcher.addEventListener("click", () => {
    if (tray.open) close();
    else { tray.show(); launcher.setAttribute("aria-expanded", "true"); }
  });
  tray.querySelector("[data-close-design]")!.addEventListener("click", close);
  document.addEventListener("keydown", event => { if (event.key === "Escape" && tray.open && !document.querySelector("dialog:modal")) { event.preventDefault(); close(); } });
  window.addEventListener("storage", event => {
    if (event.key === "site.design-tools.v1") {
      if (event.newValue === "1") document.documentElement.dataset.designTools = "true";
      else { delete document.documentElement.dataset.designTools; if (tray.open) close(); }
    }
  });
</script>
<style>
  .design-launcher { display:none; position:fixed; left:max(18px,env(safe-area-inset-left,0px)); bottom:calc(18px + env(safe-area-inset-bottom,0px)); z-index:20; place-items:center; width:56px; height:56px; border-radius:50%; border:1px solid var(--site-accent); background:var(--site-surface); color:var(--site-accent); box-shadow:0 4px 18px #0003; cursor:pointer; }
  :global(html[data-design-tools]) .design-launcher { display:grid; }
  .design-tray { position:fixed; inset:auto auto calc(84px + env(safe-area-inset-bottom,0px)) max(12px,env(safe-area-inset-left,0px)); margin:0; width:min(460px,calc(100vw - 24px)); max-width:none; max-height:calc(100dvh - 110px - env(safe-area-inset-bottom,0px)); overflow-y:auto; overscroll-behavior:contain; z-index:21; padding:16px; border:1px solid var(--site-border); border-radius:16px; background:var(--site-surface); color:var(--site-text); box-shadow:0 8px 32px #0004; font:14px/1.4 system-ui,sans-serif; }
  header { display:flex; align-items:center; gap:12px; position:sticky; top:-16px; z-index:2; background:var(--site-surface); margin:-16px -16px 0; padding:8px 16px; border-bottom:1px solid var(--site-border); }
  h2 { font:600 18px/1.3 system-ui,sans-serif; margin:0; }
  header a { margin-left:auto; color:var(--site-accent); text-decoration:underline; }
  header button { min-width:44px; min-height:44px; background:transparent; color:var(--site-text); border:0; cursor:pointer; font-size:26px; }
  .design-scope { font-size:12px; color:var(--site-muted); margin:8px 0 12px; }
  :is(button,a):focus-visible { outline:2px solid var(--site-accent); outline-offset:2px; }
  @media print { .design-launcher,.design-tray { display:none!important; } }
</style>
