<dialog class="qql-lightbox" data-qql-lightbox aria-label="Expanded QQL artwork">
  <figure class="qql-lightbox__figure">
    <img data-qql-lightbox-image alt="" />
    <button
      type="button"
      class="qql-lightbox__close"
      data-qql-lightbox-close
      aria-label="Close expanded artwork"
    >
      <svg aria-hidden="true" viewBox="0 0 24 24">
        <path d="M6 6l12 12M18 6L6 18"></path>
      </svg>
    </button>
  </figure>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>("[data-qql-lightbox]");
  const image = dialog?.querySelector<HTMLImageElement>("[data-qql-lightbox-image]");
  const closeButton = dialog?.querySelector<HTMLButtonElement>("[data-qql-lightbox-close]");

  if (dialog && image && closeButton) {
    let imageRequest = 0;

    const close = () => dialog.close();

    document.addEventListener("click", async (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;

      const trigger = target.closest<HTMLElement>("[data-qql-lightbox-src]");
      if (!trigger) return;

      const source = trigger.dataset.qqlLightboxSrc;
      const preview = trigger.querySelector<HTMLImageElement>("img");
      if (!source || !preview) return;

      const request = ++imageRequest;
      image.src = preview.currentSrc || preview.src;
      image.alt = trigger.dataset.qqlLightboxAlt || preview.alt;
      dialog.showModal();
      document.documentElement.classList.add("qql-lightbox-open");

      const highResolutionImage = new Image();
      highResolutionImage.src = source;

      try {
        await highResolutionImage.decode();
      } catch {
        return;
      }

      if (request === imageRequest && dialog.open) {
        image.src = source;
      }
    });

    closeButton.addEventListener("click", close);
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && dialog.open) {
        event.preventDefault();
        close();
      }
    });
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) close();
    });
    dialog.addEventListener("close", () => {
      imageRequest++;
      document.documentElement.classList.remove("qql-lightbox-open");
    });
  }
</script>

<style>
  :global(html.qql-lightbox-open) {
    overflow: hidden;
  }

  .qql-lightbox {
    width: 100vw;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: max(0.75rem, env(safe-area-inset-top)) max(0.75rem, env(safe-area-inset-right))
      max(0.75rem, env(safe-area-inset-bottom)) max(0.75rem, env(safe-area-inset-left));
    overflow: hidden;
    border: 0;
    background: transparent;
  }

  .qql-lightbox[open] {
    display: grid;
    place-items: center;
  }

  .qql-lightbox::backdrop {
    background: rgb(3 1 18 / 92%);
    backdrop-filter: blur(12px) saturate(85%);
  }

  .qql-lightbox__figure {
    position: relative;
    display: inline-block;
    width: fit-content;
    max-width: 100%;
    max-height: 100%;
    margin: 0;
    line-height: 0;
    box-shadow: 0 24px 80px rgb(0 0 0 / 38%);
  }

  .qql-lightbox__figure img {
    display: block;
    width: auto;
    max-width: 100%;
    height: auto;
    max-height: calc(
      100dvh - max(1.5rem, env(safe-area-inset-top) + env(safe-area-inset-bottom))
    );
    object-fit: contain;
  }

  .qql-lightbox__close {
    position: absolute;
    top: 0.65rem;
    right: 0.65rem;
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    place-items: center;
    color: white;
    cursor: pointer;
    border: 1px solid rgb(255 255 255 / 35%);
    border-radius: 999px;
    background:
      linear-gradient(145deg, rgb(255 255 255 / 24%), rgb(255 255 255 / 7%)),
      rgb(7 5 22 / 34%);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 28%),
      0 6px 24px rgb(0 0 0 / 32%);
    backdrop-filter: blur(18px) saturate(180%);
    -webkit-backdrop-filter: blur(18px) saturate(180%);
    transition:
      background-color 150ms ease,
      transform 150ms ease;
  }

  .qql-lightbox__close:hover,
  .qql-lightbox__close:focus-visible {
    background-color: rgb(255 255 255 / 16%);
    transform: scale(1.04);
  }

  .qql-lightbox__close:focus-visible {
    outline: 2px solid white;
    outline-offset: 3px;
  }

  .qql-lightbox__close svg {
    width: 1.25rem;
    height: 1.25rem;
    overflow: visible;
    filter: drop-shadow(0 1px 2px rgb(0 0 0 / 45%));
  }

  .qql-lightbox__close path {
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-width: 1.8;
  }

  @media (prefers-reduced-transparency: reduce) {
    .qql-lightbox::backdrop {
      backdrop-filter: none;
    }

    .qql-lightbox__close {
      background: rgb(7 5 22 / 88%);
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }
  }
</style>
