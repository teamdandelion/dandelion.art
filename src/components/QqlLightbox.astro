<div
  class="qql-lightbox"
  data-qql-lightbox
  role="dialog"
  aria-modal="true"
  aria-label="Expanded QQL artwork"
  hidden
>
  <button
    type="button"
    class="qql-lightbox__close"
    data-qql-lightbox-close
    aria-label="Close expanded artwork"
  >
    <svg aria-hidden="true" viewBox="0 0 24 24">
      <path d="M6 6l12 12M18 6L6 18"></path>
    </svg>
  </button>
  <figure class="qql-lightbox__figure">
    <div class="qql-lightbox__stage" data-qql-lightbox-stage>
      <img data-qql-lightbox-image alt="" draggable="false" />
      <div class="qql-loupe" data-qql-loupe aria-hidden="true">
        <div class="qql-loupe__glass">
          <img data-qql-loupe-image alt="" draggable="false" />
        </div>
      </div>
    </div>
    <figcaption data-qql-lightbox-title></figcaption>
  </figure>
</div>

<script>
  const lightbox = document.querySelector<HTMLElement>("[data-qql-lightbox]");
  const image = lightbox
    ? lightbox.querySelector<HTMLImageElement>("[data-qql-lightbox-image]")
    : null;
  const closeButton = lightbox
    ? lightbox.querySelector<HTMLButtonElement>("[data-qql-lightbox-close]")
    : null;
  const title = lightbox
    ? lightbox.querySelector<HTMLElement>("[data-qql-lightbox-title]")
    : null;
  const pageContent = document.querySelector<HTMLElement>("[data-page-content]");
  const stage = lightbox
    ? lightbox.querySelector<HTMLElement>("[data-qql-lightbox-stage]")
    : null;
  const loupe = lightbox
    ? lightbox.querySelector<HTMLElement>("[data-qql-loupe]")
    : null;
  const loupeImage = lightbox
    ? lightbox.querySelector<HTMLImageElement>("[data-qql-loupe-image]")
    : null;

  if (
    lightbox &&
    image &&
    closeButton &&
    title &&
    pageContent &&
    stage &&
    loupe &&
    loupeImage
  ) {
    const magnification = 4;
    const touchOffset = 100;
    let imageRequest = 0;
    let previousFocus: HTMLElement | null = null;
    let previousPageInert = false;
    let previousPageAriaHidden: string | null = null;
    let activePointer: number | null = null;
    let activePointerType = "";
    let frameRequest = 0;
    let latestPointer: { clientX: number; clientY: number } | null = null;
    let imageBounds: { left: number; top: number; width: number; height: number } | null = null;
    let lensSize = 0;
    const root = document.documentElement;

    const markPointerInput = () => {
      root.dataset.qqlInputModality = "pointer";
    };

    document.addEventListener("pointerdown", markPointerInput, { capture: true });
    document.addEventListener("touchstart", markPointerInput, {
      capture: true,
      passive: true,
    });

    const hideLoupe = () => {
      latestPointer = null;
      loupe.classList.remove("qql-loupe--active");
    };

    const measureLoupe = () => {
      const bounds = image.getBoundingClientRect();
      imageBounds = {
        left: bounds.left,
        top: bounds.top,
        width: bounds.width,
        height: bounds.height,
      };
      lensSize = loupe.offsetWidth;
      loupeImage.style.width = `${bounds.width * magnification}px`;
      loupeImage.style.height = `${bounds.height * magnification}px`;
    };

    const updateLoupe = () => {
      frameRequest = 0;
      if (!latestPointer || !imageBounds || lightbox.hidden) return;
      if (!imageBounds.width || !imageBounds.height || !lensSize) return;

      const radius = lensSize / 2;
      const rawX = latestPointer.clientX - imageBounds.left;
      const rawY = latestPointer.clientY - imageBounds.top;
      const displayX = Math.min(imageBounds.width - radius, Math.max(radius, rawX));
      const offset = activePointerType === "mouse" ? 0 : touchOffset;
      const minDisplayY = Math.max(0, radius + 8 - imageBounds.top);
      const displayY = Math.min(
        imageBounds.height - radius,
        Math.max(minDisplayY, rawY - offset),
      );
      const sourceMargin = radius / magnification;
      const sourceX = Math.min(
        imageBounds.width - sourceMargin,
        Math.max(sourceMargin, displayX),
      );
      const sourceY = Math.min(
        imageBounds.height - sourceMargin,
        Math.max(sourceMargin, displayY),
      );

      loupe.style.transform = `translate3d(${displayX - radius}px, ${displayY - radius}px, 0)`;
      loupeImage.style.transform = `translate3d(${radius - sourceX * magnification}px, ${radius - sourceY * magnification}px, 0)`;
    };

    const queueLoupeUpdate = (event: PointerEvent) => {
      latestPointer = { clientX: event.clientX, clientY: event.clientY };
      if (!frameRequest) frameRequest = requestAnimationFrame(updateLoupe);
    };

    const showLoupe = (event: PointerEvent) => {
      activePointerType = event.pointerType || "mouse";
      measureLoupe();
      latestPointer = { clientX: event.clientX, clientY: event.clientY };
      updateLoupe();
      loupe.classList.add("qql-loupe--active");
    };

    const close = () => {
      if (lightbox.hidden) return;
      imageRequest++;
      activePointer = null;
      imageBounds = null;
      hideLoupe();
      lightbox.hidden = true;
      document.documentElement.classList.remove("qql-lightbox-open");
      if (!previousPageInert) pageContent.removeAttribute("inert");
      if (previousPageAriaHidden === null) {
        pageContent.removeAttribute("aria-hidden");
      } else {
        pageContent.setAttribute("aria-hidden", previousPageAriaHidden);
      }
      if (previousFocus) previousFocus.focus();
    };

    document.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;

      const trigger = target.closest<HTMLElement>("[data-qql-lightbox-src]");
      if (!trigger) return;

      const source = trigger.dataset.qqlLightboxSrc;
      const preview = trigger.querySelector<HTMLImageElement>("img");
      if (!source || !preview) return;
      const zoomSource = trigger.dataset.qqlLightboxZoomSrc || source;

      const request = ++imageRequest;
      image.src = preview.currentSrc || preview.src;
      loupeImage.src = image.src;
      image.alt = trigger.dataset.qqlLightboxAlt || preview.alt;
      title.textContent = trigger.dataset.qqlLightboxTitle || preview.alt;
      previousFocus = trigger;
      lightbox.hidden = false;
      document.documentElement.classList.add("qql-lightbox-open");
      closeButton.focus();
      previousPageInert = pageContent.hasAttribute("inert");
      previousPageAriaHidden = pageContent.getAttribute("aria-hidden");
      pageContent.setAttribute("inert", "");
      pageContent.setAttribute("aria-hidden", "true");

      const highResolutionImage = new Image();
      highResolutionImage.addEventListener("load", () => {
        if (request === imageRequest && !lightbox.hidden) image.src = source;
      });
      highResolutionImage.src = source;

      const zoomImage = new Image();
      zoomImage.addEventListener("load", () => {
        if (request === imageRequest && !lightbox.hidden) loupeImage.src = zoomSource;
      });
      zoomImage.src = zoomSource;
    });

    stage.addEventListener("pointerenter", (event) => {
      if (event.pointerType === "mouse") showLoupe(event);
    });
    stage.addEventListener("pointermove", (event) => {
      if (event.pointerType === "mouse" || event.pointerId === activePointer) {
        queueLoupeUpdate(event);
      }
    });
    stage.addEventListener("pointerleave", (event) => {
      if (event.pointerType === "mouse") hideLoupe();
    });
    stage.addEventListener("pointerdown", (event) => {
      if (event.pointerType === "mouse") return;
      event.preventDefault();
      activePointer = event.pointerId;
      stage.setPointerCapture(event.pointerId);
      showLoupe(event);
    });
    const finishTouchLoupe = (event: PointerEvent) => {
      if (event.pointerId !== activePointer) return;
      activePointer = null;
      hideLoupe();
    };
    stage.addEventListener("pointerup", finishTouchLoupe);
    stage.addEventListener("pointercancel", finishTouchLoupe);
    for (const eventName of ["contextmenu", "dragstart", "selectstart"]) {
      stage.addEventListener(eventName, (event) => event.preventDefault());
    }
    window.addEventListener("resize", () => {
      imageBounds = null;
      hideLoupe();
    });

    closeButton.addEventListener("click", close);
    document.addEventListener("keydown", (event) => {
      root.dataset.qqlInputModality = "keyboard";
      if (event.key === "Escape" && !lightbox.hidden) {
        event.preventDefault();
        close();
      } else if (event.key === "Tab" && !lightbox.hidden) {
        event.preventDefault();
        closeButton.focus();
      }
    });
    lightbox.addEventListener("click", (event) => {
      if (event.target === lightbox) close();
    });
  }
</script>

<style>
  :global(html.qql-lightbox-open) {
    overflow: hidden;
  }

  .qql-lightbox {
    position: fixed;
    z-index: 100;
    inset: 0;
    margin: 0;
    padding: max(0.75rem, env(safe-area-inset-top)) max(0.75rem, env(safe-area-inset-right))
      max(0.75rem, env(safe-area-inset-bottom)) max(0.75rem, env(safe-area-inset-left));
    overflow: hidden;
    background: rgb(3 1 18);
  }

  .qql-lightbox:not([hidden]) {
    display: grid;
    place-items: center;
  }

  .qql-lightbox__figure {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: fit-content;
    max-width: 100%;
    max-height: 100%;
    margin: 0;
  }

  .qql-lightbox__stage {
    position: relative;
    max-width: 100%;
    max-height: 100%;
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .qql-lightbox__stage {
      cursor: none;
    }
  }

  .qql-lightbox__stage > img {
    display: block;
    width: auto;
    max-width: 100%;
    height: auto;
    max-height: calc(
      100dvh - max(1.5rem, env(safe-area-inset-top) + env(safe-area-inset-bottom)) - 2.4rem
    );
    object-fit: contain;
    pointer-events: none;
    -webkit-user-drag: none;
    box-shadow: 0 24px 80px rgb(0 0 0 / 38%);
  }

  .qql-loupe {
    position: absolute;
    z-index: 2;
    top: 0;
    left: 0;
    width: clamp(11.75rem, 48vw, 13.75rem);
    aspect-ratio: 1;
    pointer-events: none;
    contain: layout paint style;
    will-change: transform;
  }

  .qql-loupe__glass {
    position: relative;
    width: 100%;
    height: 100%;
    box-sizing: border-box;
    overflow: hidden;
    border: 2px solid rgb(255 255 255 / 36%);
    border-radius: 50%;
    opacity: 0;
    background: transparent;
    transform: scale(0);
    transition:
      transform 340ms cubic-bezier(0.22, 0.65, 0.2, 1),
      opacity 260ms ease-out;
    will-change: transform, opacity;
  }

  .qql-loupe--active .qql-loupe__glass {
    opacity: 1;
    transform: scale(1);
    transition-duration: 460ms, 300ms;
    transition-timing-function: cubic-bezier(0.18, 0.85, 0.24, 1.08), ease-out;
  }

  .qql-loupe__glass > img {
    position: absolute;
    top: 0;
    left: 0;
    max-width: none;
    object-fit: fill;
    pointer-events: none;
    -webkit-user-drag: none;
    transform-origin: 0 0;
    will-change: transform;
  }

  .qql-lightbox__close {
    position: absolute;
    z-index: 1;
    top: max(0.75rem, env(safe-area-inset-top));
    right: max(0.75rem, env(safe-area-inset-right));
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    place-items: center;
    color: white;
    cursor: pointer;
    border: 1px solid rgb(255 255 255 / 35%);
    border-radius: 999px;
    background:
      linear-gradient(145deg, rgb(255 255 255 / 24%), rgb(255 255 255 / 7%)),
      rgb(7 5 22 / 34%);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 28%),
      0 6px 24px rgb(0 0 0 / 32%);
    backdrop-filter: blur(18px) saturate(180%);
    -webkit-backdrop-filter: blur(18px) saturate(180%);
    transition:
      background-color 150ms ease,
      transform 150ms ease;
  }

  .qql-lightbox__close:hover,
  :global(html[data-qql-input-modality="keyboard"]) .qql-lightbox__close:focus {
    background-color: rgb(255 255 255 / 16%);
    transform: scale(1.04);
  }

  .qql-lightbox__close:focus {
    outline: none;
  }

  :global(html[data-qql-input-modality="keyboard"]) .qql-lightbox__close:focus {
    outline: 2px solid white;
    outline-offset: 3px;
  }

  .qql-lightbox__close svg {
    width: 1.25rem;
    height: 1.25rem;
    overflow: visible;
    filter: drop-shadow(0 1px 2px rgb(0 0 0 / 45%));
  }

  .qql-lightbox__close path {
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-width: 1.8;
  }

  .qql-lightbox__figure figcaption {
    margin-top: 0.7rem;
    color: rgb(255 255 255 / 72%);
    font-size: 0.85rem;
    font-weight: 400;
    letter-spacing: 0.04em;
    line-height: 1.4;
    text-align: center;
  }

  @media (prefers-reduced-transparency: reduce) {
    .qql-lightbox__close {
      background: rgb(7 5 22 / 88%);
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .qql-loupe__glass {
      transition-duration: 1ms;
    }
  }
</style>
