---
import logoUrl from "../assets/logo.svg?url";
import QqlLightbox from "../components/QqlLightbox.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import MusicSettings from "../components/music/MusicSettings";
import PaletteHead from "../components/PaletteHead.astro";
import PaletteReview from "../components/PaletteReview.astro";
import { DEFAULT_PALETTE } from "../lib/palettes";
import "../styles/style.css";
import "../styles/tailwind.css";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  title = "dandelion.art",
  description = "Dandelion Mané's personal site.",
  noindex = false,
} = Astro.props;
const pathname = Astro.url.pathname.replace(/\/+$/, "") || "/";
const hasQqlLightbox = pathname === "/" || pathname === "/art/qql";
const isMusic = pathname === "/music" || pathname.startsWith("/music/");
---

<!doctype html>
<html lang="en" data-palette={DEFAULT_PALETTE} data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href={logoUrl} />
    {
      Astro.url.pathname === "/" && (
        <link rel="preload" as="image" href="/art/qql-276.png" />
      )
    }
    <title>{title}</title>
    <PaletteHead />
  </head>
  <body>
    <div class="min-h-screen bg-base-100" data-page-content>
      <header data-site-header class="border-b border-base-300 bg-base-200">
        <div
          class="max-w-5xl mx-auto px-5 py-2 flex items-center justify-between"
        >
          <a href="/" class="flex items-center">
            <img
              src={logoUrl}
              height="28"
              width="28"
              alt="logo"
              class="[html[data-theme='dark']_&]:invert"
            />
          </a>
          <div class="flex items-center gap-6">
            <nav class="flex items-center gap-6">
              <a href="/" aria-current={Astro.url.pathname === "/" ? "page" : undefined}>
                Home
              </a>
              <a
                href="/art"
                aria-current={
                  Astro.url.pathname === "/art" ||
                  Astro.url.pathname.startsWith("/art/")
                    ? "page"
                    : undefined
                }
              >
                Art
              </a>
              <a href="/music" class="music-link" aria-label="Music" title="Music" aria-current={isMusic ? "page" : undefined}>
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M9 18V5l12-2v13M9 9l12-2" />
                  <ellipse cx="6" cy="18" rx="3" ry="3" />
                  <ellipse cx="18" cy="16" rx="3" ry="3" />
                </svg>
              </a>
            </nav>
            <ThemeToggle />
          </div>
        </div>
      </header>
      <PaletteReview />
      <main class:list={["max-w-5xl mx-auto px-5 py-8", { "music-page": isMusic }]}>
        <slot />
      </main>
    </div>
    {hasQqlLightbox && <QqlLightbox />}
    {isMusic && <MusicSettings client:load />}
  </body>
</html>

<style>
  .music-link { display:grid; place-items:center; min-width:44px; min-height:44px; }
  .music-link:focus-visible { outline:2px solid var(--site-accent); outline-offset:2px; border-radius:6px; }
</style>
