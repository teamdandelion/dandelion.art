---
import LayoutDefault from "../../layouts/LayoutDefault.astro";
---

<LayoutDefault
  title="Music — dandelion.art"
  description="A small collection of personal tools for making and understanding music."
  noindex
>
  <article class="music-index">
    <p class="eyebrow">A personal practice room</p>
    <h1>Music</h1>
    <p class="intro">Small tools for playing, listening, and finding connections.</p>
    <a class="music-app" href="/music/chords">
      <div class="app-mark" aria-hidden="true">C<span> E G</span></div>
      <div>
        <p class="eyebrow">01 / Reference & exploration</p>
        <h2>Chord atlas</h2>
        <p>Baritone ukulele shapes, the same notes on a piano, and the relationships between chords in a key.</p>
        <span class="open">Open the atlas <span aria-hidden="true">↗</span></span>
      </div>
    </a>
    <p class="footnote">An unlisted corner of the site. Public if you have the link; not in the navigation.</p>
  </article>
</LayoutDefault>

<style>
  .music-index { max-width: 52rem; margin: 3rem auto; }
  .eyebrow { font-size: 0.72rem; font-weight: 600; letter-spacing: 0.13em; text-transform: uppercase; opacity: 0.6; }
  h1 { margin: 0.6rem 0; font-family: Georgia, serif; font-size: clamp(3rem, 8vw, 5rem); font-weight: 400; line-height: 1.1; }
  .intro { font-size: 1.1rem; line-height: 1.7; opacity: 0.75; }
  .music-app { display: grid; grid-template-columns: 7rem 1fr; gap: 2rem; margin: 2.5rem 0; padding: 2rem; border: 1px solid color-mix(in oklch, currentColor 20%, transparent); border-radius: 1rem; background: color-mix(in oklch, currentColor 3%, transparent); }
  .music-app:hover { border-color: currentColor; }
  .music-app:focus-visible { outline: 2px solid currentColor; outline-offset: 5px; }
  .app-mark { align-self: center; font-family: Georgia, serif; font-size: 4rem; }
  .app-mark span { font-size: 1.4rem; opacity: 0.5; }
  h2 { margin: 0.5rem 0; font-family: Georgia, serif; font-size: 2rem; font-weight: 400; }
  .music-app p:not(.eyebrow) { max-width: 30rem; line-height: 1.6; opacity: 0.75; }
  .open { display: inline-block; margin-top: 1.5rem; text-decoration: underline; text-underline-offset: 0.25em; }
  .footnote { font-size: 0.8rem; line-height: 1.6; opacity: 0.6; }
  @media (max-width: 560px) { .music-index { margin-top: 1.5rem; } .music-app { grid-template-columns: 1fr; gap: 0.8rem; padding: 1.5rem; } .app-mark { font-size: 3rem; } }
</style>
